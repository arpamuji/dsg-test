        "@types/supertest": "^7.2.0",
        "eslint": "^10.2.0",
        "prettier": "^3.8.1",
        "prisma": "^7.6.0",
        "supertest": "^7.2.2",
        "tsx": "^4.21.0",
        "typescript": "^6.0.2",
